# AI-OS Centralized Environment Configuration Template

# Local Ollama Provider Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Per-Service Model Overrides (Optional - defaults to OLLAMA_MODEL if unset)
OPENINTERPRETER_MODEL=ollama/qwen3:8b
BROWSER_USE_MODEL=ollama/qwen3:8b
OPENHANDS_MODEL=ollama/qwen3:8b
CREWAI_MODEL=ollama/qwen3:8b
AUTOGPT_MODEL=ollama/qwen3:8b

# Service Binding Ports
GATEWAY_PORT=8000
OPENINTERPRETER_PORT=8101
BROWSER_USE_PORT=8102
OPENHANDS_PORT=8103
CREWAI_PORT=8104
AUTOGPT_PORT=8105

# Gateway Timeout & Runtime Settings
DEFAULT_HTTP_TIMEOUT=180.0
